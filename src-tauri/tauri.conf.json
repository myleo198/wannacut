{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WannaCut",
  "version": "0.4.0",
  "identifier": "com.wannacut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
    {
      "title": "WannaCut",
      "width": 1280,
      "height": 720,
      "minWidth": 800,
      "minHeight": 600,
      "resizable": true,
      "maximized": true,
      "dragDropEnabled": true
    }
    ]
    ,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "linux": {
      "deb": {
        "depends": [
          "libarmadillo12",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libdc1394-25",
          "libraw1394-11",
          "ffmpeg",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "ffmpeg",
          "gstreamer1-plugins-bad-free",
          "gstreamer1-libav"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}